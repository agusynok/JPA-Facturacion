<?xml version="1.0" encoding="UTF-8"?>

<persistence
        version="3.1"
        xmlns="https://jakarta.ee/xml/ns/persistence"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                            https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd">

    <persistence-unit name="FacturacionPU" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>org.example.entidades.Usuario</class>
        <class>org.example.entidades.Contacto</class>
        <class>org.example.entidades.Domicilio</class>
        <class>org.example.entidades.Cliente</class>
        <class>org.example.entidades.CondicionIva</class>
        <class>org.example.entidades.TipoMoneda</class>
        <class>org.example.entidades.Rubro</class>
        <class>org.example.entidades.Marca</class>
        <class>org.example.entidades.Articulo</class>
        <class>org.example.entidades.ListaPrecio</class>
        <class>org.example.entidades.ListaPrecioArticulo</class>
        <class>org.example.entidades.PuntoVenta</class>
        <class>org.example.entidades.FacturaVenta</class>
        <class>org.example.entidades.FacturaVentaDetalle</class>

        <properties>

            <!-- Conexión a MariaDB -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mariadb://localhost:3306/jpa_prueba"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="maria123"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.mariadb.jdbc.Driver"/>

            <!-- Dialecto de Hibernate -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MariaDBDialect"/>

            <!-- Actualiza/crea las tablas según las entidades -->
            <property name="hibernate.hbm2ddl.auto" value="drop-and-create"/>

            <!-- Mostrar SQL -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>